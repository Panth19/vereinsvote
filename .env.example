# copy to .env for local development
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://vv:vv@localhost:5432/vereinsvote
# Where users open the app (Vite dev server locally, your domain in production)
APP_URL=http://localhost:5173
# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=dev-secret-change-me-please
# Leave empty for demo mode: vote confirmation links are shown in the UI instead of emailed.
# Example for a real SMTP server: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=VereinsVote <no-reply@example.com>
# fill an empty database with demo data on first start
SEED_DEMO_DATA=false
# number of proxies in front of the app (0 locally, 1 on Render)
TRUST_PROXY_HOPS=0
